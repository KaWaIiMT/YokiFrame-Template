# ===== Unity generated / local-only directories =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures / recordings can be large
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ===== Autogenerated IDE / solution files =====
.vs/
.consulo/
ExportedObj/
*.csproj
*.sln
*.slnx
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ===== Local tooling state (YokiFrame / MCP engines) =====
/.yokiframe/

# Local VS Code workspace config (machine-specific PATH etc.)
/.vscode/settings.json

# ===== OS junk =====
.DS_Store
Thumbs.db

# ===== Build outputs =====
*.apk
*.aab
*.unitypackage
*.app

# Unity 6 crash recovery snapshots (transient, do not commit)
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temp auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
